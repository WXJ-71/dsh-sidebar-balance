{
  "name": "@local/dsh-sidebar-balance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows the DeepSeek account balance at the sidebar foot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WXJ-71/dsh-sidebar-balance.git"
  },
  "homepage": "https://github.com/WXJ-71/dsh-sidebar-balance#readme",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "README.md",
    "INSTALL.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
